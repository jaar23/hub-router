# Copy this file to deploy/.env and fill in real values.
# The .env file is loaded by docker-compose and MUST NOT be committed to git.

# ── Required: API keys ────────────────────────────────────────────────────────
# Comma-separated list of keys accepted from the online server.
# Generate with: openssl rand -hex 32
HR_ONLINE_API_KEYS=change-me-online-key-1,change-me-online-key-2

# Comma-separated list of keys accepted from the local server.
HR_LOCAL_API_KEYS=change-me-local-key-1

# Key required to access GET /metrics (leave empty to disable admin auth).
HR_ADMIN_API_KEY=

# ── Optional: tune security ───────────────────────────────────────────────────
# Token-bucket rate: max sustained requests/second per IP (0 = disabled).
HR_RATE_LIMIT_RPS=50
# Token-bucket burst: max simultaneous requests per IP.
HR_RATE_LIMIT_BURST=100

# Auth failure lockout: block an IP after this many consecutive bad keys.
HR_LOCKOUT_THRESHOLD=10
# How long a locked IP stays blocked (Go duration: 15m, 1h, etc.).
HR_LOCKOUT_DURATION=15m
# Sliding window within which failures are counted before resetting.
HR_LOCKOUT_WINDOW=10m

# Maximum request body size in bytes (default 1 MiB = 1048576).
HR_MAX_BODY_BYTES=1048576

# ── Optional: queue / result tuning ──────────────────────────────────────────
HR_QUEUE_MAX_SIZE=10000
HR_REQUEST_TTL=5m
HR_MAX_BATCH_SIZE=100
HR_LONGPOLL_TIMEOUT=30s
HR_WRITE_TIMEOUT=35s
HR_RESULT_TTL=10m

# ── Optional: logging ─────────────────────────────────────────────────────────
HR_LOG_LEVEL=info
HR_LOG_FORMAT=json
